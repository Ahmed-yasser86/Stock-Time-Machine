@model StockTrade

<h2>@Model.StockName (@Model.StockSymbol)</h2>
<h3>Price: $<span id="stockPrice">@Model.Price</span></h3>

<hr />

<div class="row">
    <div class="col-md-4">
        <form method="post">
            <input type="hidden" id="stockSymbol" name="StockSymbol" value="@Model.StockSymbol" />
            <input type="hidden" id="stockName" name="StockName" value="@Model.StockName" />
            <input type="hidden" id="hiddenPrice" name="Price" value="@Model.Price" />

            <div class="form-group mb-3">
                <label class="form-label">Quantity:</label>
                <input type="number" name="Quantity" class="form-control" value="1" min="1" id="quantityInput" />
            </div>

            <div class="button-group">
                <button type="submit" asp-area="Stocks" asp-controller="Trade" asp-action="BuyOrders"
                        class="btn btn-success" onclick="updatePriceBeforeSubmit()">
                    Buy Order
                </button>

                <button type="submit" asp-area="Stocks" asp-controller="Trade" asp-action="SellOrders"
                        class="btn btn-danger" onclick="updatePriceBeforeSubmit()">
                    Sell Order
                </button>
            </div>
        </form>
    </div>
</div>

<script>
    // WebSocket connection requires a backend proxy to avoid exposing API tokens.
    // Token removed from client-side — see M6 security fix.
    const priceDisplay = document.getElementById("stockPrice");
    const hiddenPriceInput = document.getElementById("hiddenPrice");

    function updatePriceBeforeSubmit() {
        hiddenPriceInput.value = priceDisplay.innerText;
    }
</script>


<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.21.0/jquery.validate.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate-unobtrusive/3.2.12/jquery.validate.unobtrusive.min.js"></script>