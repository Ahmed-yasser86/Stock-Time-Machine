@model StocksApp2.Areas.TimeMachine.Models.TimeMachineSearchModel
@{
    ViewData["Title"] = "Stock Time Machine";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="text-center mb-4">
                <h1>Stock Time Machine</h1>
                <p class="text-muted">What could a reasonable investor have known?</p>
            </div>

            <div class="card">
                <div class="card-body">
                    <form method="post">
                        @Html.AntiForgeryToken()
                        <div class="row g-3">
                            <div class="col-md-5">
                                <label asp-for="Symbol" class="form-label"></label>
                                <input asp-for="Symbol" class="form-control form-control-lg" placeholder="e.g. TSLA, AAPL, MSFT" autofocus />
                                <span asp-validation-for="Symbol" class="text-danger"></span>
                            </div>
                            <div class="col-md-5">
                                <label asp-for="SnapshotDate" class="form-label"></label>
                                <input asp-for="SnapshotDate" type="date" class="form-control form-control-lg" />
                                <span asp-validation-for="SnapshotDate" class="text-danger"></span>
                            </div>
                            <div class="col-md-2 d-flex align-items-end">
                                <button type="submit" class="btn btn-primary btn-lg w-100">Enter</button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>

            <div class="mt-4">
                <h6>Try these:</h6>
                <div class="d-flex gap-2 flex-wrap">
                    <a asp-action="Snapshot" asp-route-symbol="TSLA" asp-route-date="2020-01-15" class="btn btn-outline-secondary btn-sm">TSLA — Jan 2020</a>
                    <a asp-action="Snapshot" asp-route-symbol="AAPL" asp-route-date="2020-01-15" class="btn btn-outline-secondary btn-sm">AAPL — Jan 2020</a>
                    <a asp-action="Snapshot" asp-route-symbol="MSFT" asp-route-date="2020-01-15" class="btn btn-outline-secondary btn-sm">MSFT — Jan 2020</a>
                    <a asp-action="Snapshot" asp-route-symbol="TSLA" asp-route-date="2021-01-01" class="btn btn-outline-secondary btn-sm">TSLA — Jan 2021</a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
