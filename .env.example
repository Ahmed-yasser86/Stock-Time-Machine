# Stock Time Machine — local environment template.
# Copy to .env (never commit .env) and fill in what you have. Every provider
# key is OPTIONAL: without keys the API serves cached/degraded data honestly.
# Only MSSQL_SA_PASSWORD is required (SQL Server refuses to start without it).

# REQUIRED — SQL Server sa password (8+ chars, letters + digits + symbols).
MSSQL_SA_PASSWORD=YourStrong@Pass123

# REQUIRED for resemblance features — Qdrant Cloud (API-key only, no local
# container). Host without scheme, e.g.
# xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx.us-east.aws.cloud.qdrant.io
# Without these, resemblance falls back to the in-memory store automatically.
QDRANT_HOST=
QDRANT_PORT=6334
QDRANT_API_KEY=

# Browser → API base URL baked into the frontend image at build time.
VITE_API_URL=http://localhost:8080

# FinBERT sidecar toggle (the sidecar still runs; the API just skips it).
NLP_ENABLED=true

# Vector store (local Qdrant needs no key; set one only for Qdrant Cloud).
QDRANT_API_KEY=

# External providers (all optional, all server-side only — never logged,
# never returned to browsers).
GEMINI_API_KEY=
JINA_API_KEY=
FINNHUB_TOKEN=
ALPHAVANTAGE_API_KEY=
GDELT_API_KEY=
MARKETAUX_API_KEY=

# News source default (gdelt | gdelt-cloud | alphavantage | marketaux).
NEWS_DEFAULT_SOURCE=gdelt

# SEC EDGAR requires a contact User-Agent on every request.
SEC_USER_AGENT=StockTimeMachine/1.0 (contact: your@email.com)
