{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "AllowedHosts": "*",

  "TradingOptions": {
    "DefaultStockSymbol": "MSFT"
  },

  "AlphaVantage": {
    "ApiKey": "",
    "BaseUrl": "https://www.alphavantage.co/query",
    "PaceSeconds": "12"
  },

  "SecEdgar": {
    "BaseUrl": "https://data.sec.gov",
    "UserAgent": "StockTimeMachine/1.0 (contact: your@email.com)"
  },

  "Gdelt": {
    "BaseUrl": "https://api.gdeltproject.org/api/v2",
    "CloudBaseUrl": "https://gdeltcloud.com",
    "ApiKey": ""
  },

  "News": {
    "DefaultSource": "gdelt"
  },

  "RateLimits": {
    "_comment": "Production rhythm for the global adaptive limiter. Code defaults are zero-delay (fast hermetic tests); legacy per-provider keys below still override these.",
    "gdelt": { "InitialDelayMs": "3000", "MaxBatchSize": "2" },
    "alphavantage": { "InitialDelayMs": "12000", "MaxBatchSize": "1" },
    "arctic": { "InitialDelayMs": "1500", "MaxBatchSize": "1" },
    "marketaux": { "InitialDelayMs": "1000", "MaxBatchSize": "2" },
    "jina": { "InitialDelayMs": "2000", "MaxBatchSize": "4" },
    "gemini-embed": { "InitialDelayMs": "1000", "MaxBatchSize": "4", "TokensPerMinute": "30000" },
    "gemini-generate": { "InitialDelayMs": "4000", "MaxBatchSize": "2", "TokensPerMinute": "30000" }
  },

  "MarketAux": {
    "BaseUrl": "https://api.marketaux.com",
    "ApiKey": ""
  },

  "Social": {
    "ArcticShift": {
      "BaseUrl": "https://arctic-shift.photon-reddit.com",
      "Enabled": "true",
      "Subreddits": "wallstreetbets"
    }
  },

  "ConnectionStrings": {
    "ContactDb": "Server=localhost;Database=Contect_Manager;Integrated Security=True;TrustServerCertificate=True;",
    "StocksDbConnection": "Server=localhost;Database=StocksDb;Integrated Security=True;TrustServerCertificate=True;",
    "StockTimeMachineDb": "Server=localhost;Database=StockTimeMachineDb;Integrated Security=True;TrustServerCertificate=True;"
  },

  "Serilog": {
    "MinimumLevel": "Debug",
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File"
    ],
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/log-.txt",
          "rollingInterval": "Day"
        }
      }
    ]
  }
}